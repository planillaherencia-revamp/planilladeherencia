# Copia este archivo a .env.local y llena los valores reales.
# .env.local nunca se sube a git (ver .gitignore).

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sensible: solo se usa en el servidor (Route Handlers), nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (para links de cotización, cuestionario, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anthropic — para el OCR de documentos (Fase 2, uso admin únicamente)
ANTHROPIC_API_KEY=

# Stripe — pendiente Fase 4
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend — pendiente para envío real de correos (contacto, cotizaciones)
RESEND_API_KEY=
